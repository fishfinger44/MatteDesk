set cut_paste_input [stack 0]
version 15.0 v1
push 0
push $cut_paste_input
Group {
 inputs 2
 name MergeMatte
 tile_color 0x2f8f5fff
 label "v01"
 note_font_size 14
 xpos 0
 ypos 0
 addUserKnob {20 mergematte l MergeMatte}
 addUserKnob {26 t_alpha l "" +STARTLINE T "<b><u>Alpha</u></b>  (FG matte, before anything else)"}
 addUserKnob {7 choke l "choke (+) / expand (-) \[px\]" t "FilterErode (gaussian) of the FG alpha" R -20 20}
 choke 0
 addUserKnob {7 soften l "soften \[px\]" t "Blur of the FG alpha after the choke" R 0 20}
 soften 0
 addUserKnob {26 t_decon l "" +STARTLINE T "<b><u>Decontaminate</u></b>  (interior colour replaces old-background colour in the edge)"}
 addUserKnob {7 decon l "amount" R 0 1}
 decon 1
 addUserKnob {7 decon_spread l "spread \[px\]" t "how far the interior colour is spread into the edge" R 1 100}
 decon_spread 30
 addUserKnob {26 t_darken l "" +STARTLINE T "<b><u>Darken edge</u></b>  (bright FG edges go down to the BG level, only over a darker BG)"}
 addUserKnob {7 darken l "amount" t "min(comp, BG) inside the edge band" R 0 1}
 darken 1
 addUserKnob {7 darken_width l "width \[px\]" R 0 30}
 darken_width 8
 addUserKnob {26 t_match l "" +STARTLINE T "<b><u>Match edge</u></b>  (grade the edge band to sit in the BG)"}
 addUserKnob {7 match l "amount" R 0 1}
 match 0
 addUserKnob {7 match_exposure l "exposure \[stops\]" R -3 3}
 match_exposure 0
 addUserKnob {7 match_saturation l "saturation" R 0 2}
 match_saturation 1
 addUserKnob {7 match_width l "width \[px\]" R 0 30}
 match_width 4
 addUserKnob {26 t_wrap l "" +STARTLINE T "<b><u>Light wrap</u></b>  (BG light wraps over the FG edge)"}
 addUserKnob {7 wrap l "wrap amount" t "all BG values wrap over the FG" R 0 1}
 wrap 0.2
 addUserKnob {7 wrap_size l "size \[px\]" t "wrap and flare share this size (x1, x2, x4, x8 blur stack)" R 0 20}
 wrap_size 5
 addUserKnob {7 flare l "flare amount" t "only the bright parts of the BG (luminance key) wrap over the FG" R 0 1}
 flare 0
 addUserKnob {7 flare_threshold l "flare threshold" t "BG luminance where the flare key starts" R 0 1}
 flare_threshold 0.6
 addUserKnob {7 flare_softness l "flare softness" t "key ramp width above the threshold" R 0 1}
 flare_softness 0.2
 addUserKnob {26 t_bleed l "" +STARTLINE T "<b><u>Bleed colour</u></b>  (BG hue replaces FG hue near the edge)"}
 addUserKnob {7 bleed l "amount" R 0 1}
 bleed 0
 addUserKnob {7 bleed_size l "size \[px\]" R 0 10}
 bleed_size 5
 addUserKnob {26 t_edge l "" +STARTLINE T "<b><u>Edge blur</u></b>  (blurs the semi-transparent edge of the composite)"}
 addUserKnob {7 edge_blur l "amount" R 0 10}
 edge_blur 1
 addUserKnob {26 div l "" +STARTLINE T ""}
 addUserKnob {6 log l "Apply operations in Log (ACEScct)" +STARTLINE}
 log true
 addUserKnob {7 mix l "mix" R 0 1}
 mix 1
 addUserKnob {6 bypass l "Regular Over" t "bypass: plain Merge over (after Alpha / Log)" +STARTLINE}
 bypass false
 addUserKnob {41 bbox l "set bbox to" T fg_over_bg.bbox}
}
Input {
 inputs 0
 name BG
 xpos 900
 ypos 0
}
set NBG [stack 0]
Input {
 inputs 0
 number 1
 name FG
 xpos 0
 ypos 0
}
